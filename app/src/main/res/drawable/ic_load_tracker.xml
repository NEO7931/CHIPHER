<!-- res/drawable/ic_load_tracker.xml -->
<!-- Signal bars icon for the Load Tracker bottom nav tab -->
<!-- Replace @android:drawable/ic_menu_call in bottom_nav_menu.xml with @drawable/ic_load_tracker -->
