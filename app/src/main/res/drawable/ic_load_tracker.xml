    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Bar 1 (shortest — leftmost) -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M2,18 L2,20 L4,20 L4,18 Z"/>

    <!-- Bar 2 -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M6,15 L6,20 L8,20 L8,15 Z"/>

    <!-- Bar 3 -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M10,11 L10,20 L12,20 L12,11 Z"/>

    <!-- Bar 4 (tallest — rightmost) -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M14,7 L14,20 L16,20 L16,7 Z"/>

    <!-- Philippine Peso sign hint — small ₱ dot cluster below bars -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M19,16 L22,16 L22,17.5 L19,17.5 Z"/>
    <path
        android:fillColor="@android:color/white"
        android:pathData="M19,19 L22,19 L22,20.5 L19,20.5 Z"/>

