<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:paddingStart="@dimen/dialog_content_inset"
    android:paddingEnd="@dimen/dialog_content_inset">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilSearchApps"
        style="@style/Widget.CHIPHERLOCK.TextInputLayout.Dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/search_apps"
        app:startIconDrawable="@drawable/ic_search"
        app:startIconTint="@color/cipher_text_muted">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSearchApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <ListView
        android:id="@+id/listApps"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_marginTop="4dp"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="vertical" />
</LinearLayout>
