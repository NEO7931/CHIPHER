<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Security Coach"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#1A1A2E"
        android:paddingBottom="4dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Daily security tips to keep you safe"
        android:textSize="14sp"
        android:textColor="#666666"
        android:paddingBottom="16dp"/>

    <TextView
        android:id="@+id/tv_tip_counter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tip 1 of 10"
        android:textSize="12sp"
        android:textColor="#457B9D"
        android:paddingBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A1A2E"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_tip_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tip Title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:paddingBottom="8dp"/>

        <TextView
            android:id="@+id/tv_tip_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tip subtitle"
            android:textSize="16sp"
            android:textColor="#E63946"
            android:textStyle="bold"
            android:paddingBottom="12dp"/>

        <TextView
            android:id="@+id/tv_tip_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tip body"
            android:textSize="14sp"
            android:textColor="#CCCCCC"
            android:lineSpacingExtra="4dp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btn_prev_tip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PREVIOUS"
            android:backgroundTint="#457B9D"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btn_next_tip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NEXT TIP"
            android:backgroundTint="#E63946"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</LinearLayout>