<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="Network Monitor"
        android:textColor="#1A1A2E"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="16dp"
        android:text="Detects unsafe WiFi, evil twins and network threats"
        android:textColor="#666666"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btn_scan_network"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#E63946"
        android:padding="14dp"
        android:text="SCAN ALL NEARBY NETWORKS"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/tv_network_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp"
            android:padding="12dp"
            android:text="Press SCAN CURRENT NETWORK to analyse your WiFi connection..."
            android:textColor="#1A1A2E"
            android:textSize="14sp" />

    </ScrollView>

</LinearLayout>