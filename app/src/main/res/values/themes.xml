<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.CHIPHERLOCK" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/cipher_primary</item>
        <item name="colorOnPrimary">@color/cipher_on_primary</item>
        <item name="colorPrimaryContainer">@color/cipher_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/cipher_text_primary</item>
        <item name="colorSecondary">@color/cipher_info</item>
        <item name="colorError">@color/cipher_danger</item>
        <item name="colorSurface">@color/cipher_surface</item>
        <item name="colorSurfaceVariant">@color/cipher_surface_high</item>
        <item name="colorOnSurface">@color/cipher_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/cipher_text_secondary</item>
        <item name="colorOutline">@color/cipher_outline</item>
        <item name="android:colorAccent">@color/cipher_primary</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@color/cipher_background</item>
        <item name="android:navigationBarColor">@color/cipher_surface</item>
        <item name="android:windowBackground">@color/cipher_background</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.CHIPHERLOCK.Dialog</item>
    </style>

    <style name="Theme.CHIPHERLOCK" parent="Base.Theme.CHIPHERLOCK" />

    <style name="ThemeOverlay.CHIPHERLOCK.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/cipher_glass</item>
        <item name="colorSurfaceContainerHigh">@color/cipher_glass</item>
        <item name="colorSurfaceContainerHighest">@color/cipher_glass</item>
        <item name="colorOnSurface">@color/cipher_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/cipher_text_secondary</item>
        <item name="colorPrimary">@color/cipher_primary</item>
        <item name="android:backgroundDimAmount">0.32</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="dialogCornerRadius">28dp</item>
        <item name="android:windowAnimationStyle">@style/Animation.CHIPHERLOCK.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.CHIPHERLOCK.DialogTitle</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.CHIPHERLOCK.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.CHIPHERLOCK.DialogButton.Neutral</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.CHIPHERLOCK.DialogButton.Neutral</item>
    </style>

    <style name="TextAppearance.CHIPHERLOCK.DialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/cipher_text_primary</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Widget.CHIPHERLOCK.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/cipher_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">20dp</item>
        <item name="rippleColor">@color/cipher_glass_stroke</item>
    </style>

    <style name="Widget.CHIPHERLOCK.DialogButton.Neutral" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/cipher_text_secondary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Animation.CHIPHERLOCK.Dialog" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>

    <style name="Widget.CHIPHERLOCK.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/cipher_surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/cipher_outline_soft</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.CHIPHERLOCK.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.CHIPHERLOCK.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/cipher_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.CHIPHERLOCK.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/cipher_text_secondary</item>
    </style>

    <style name="Widget.CHIPHERLOCK.TextInputLayout.Dialog" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundMode">outline</item>
        <item name="boxBackgroundColor">@color/cipher_glass_field</item>
        <item name="boxStrokeColor">@color/cipher_glass_stroke_state</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="hintTextColor">@color/cipher_text_secondary</item>
        <item name="android:textColorHint">@color/cipher_text_muted</item>
    </style>

    <style name="Widget.CHIPHERLOCK.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/cipher_surface</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/cipher_textinput_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/cipher_text_muted</item>
        <item name="android:textColorHint">@color/cipher_text_muted</item>
    </style>
</resources>